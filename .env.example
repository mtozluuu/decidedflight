DATABASE_URL=sqlite:///./decideflight.db
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
WEATHERAPI_API_KEY=your_weatherapi_api_key
WINDY_API_KEY=your_windy_api_key
DEBUG=false

# --- Optional: override drone flight limits ---
# WIND_OK_MAX_KNOTS=15
# WIND_RISKY_MAX_KNOTS=25
# VISIBILITY_OK_MIN_KM=5
# VISIBILITY_RISKY_MIN_KM=1
# TEMP_OK_MIN_C=0
# TEMP_OK_MAX_C=40
# TEMP_RISKY_MIN_C=-5
# TEMP_RISKY_MAX_C=45
# HUMIDITY_OK_MAX_PCT=85
# HUMIDITY_RISKY_MAX_PCT=95
# CLOUD_BASE_OK_MIN_FT=500
# CLOUD_BASE_RISKY_MIN_FT=200
# CLOUD_CEILING_OK_MIN_FT=1000
# CLOUD_CEILING_RISKY_MIN_FT=500
